+
+bool modifierPressed(int modifier, int leftKey, int rightKey) {
+	return modifier == 0 || (GetAsyncKeyState(leftKey) & 0x8000) != 0
+		   || (GetAsyncKeyState(rightKey) & 0x8000) != 0;
+}
+
+bool hotkeyPressed(int virtualKey, int modifiers) {
+	if (virtualKey <= 0 || virtualKey > 255 || (GetAsyncKeyState(virtualKey) & 0x8000) == 0) {
+		return false;
+	}
+	return modifierPressed(modifiers & 1, VK_LSHIFT, VK_RSHIFT)
+		   && modifierPressed(modifiers & 2, VK_LCONTROL, VK_RCONTROL)
+		   && modifierPressed(modifiers & 4, VK_LMENU, VK_RMENU)
+		   && modifierPressed(modifiers & 8, VK_LWIN, VK_RWIN);
+}
+
+void runHotkeys() {
+	bool muteWasDown = false;
+	bool pushToTalkWasDown = false;
+	while (g_running.load()) {
+		const bool muteDown = hotkeyPressed(g_muteVirtualKey.load(), g_muteModifiers.load());
+		if (muteDown && !muteWasDown) {
+			mumble_connection_t connection{};
+			bool muted = false;
+			if (g_api.getActiveServerConnection(g_pluginID, &connection) == MUMBLE_STATUS_OK
+				&& g_api.isLocalUserMuted(g_pluginID, &muted) == MUMBLE_STATUS_OK) {
+				g_api.requestLocalUserMute(g_pluginID, !muted);
+			}
+		}
+		muteWasDown = muteDown;
+
+		const bool pushToTalkDown =
+			g_pushToTalkEnabled.load()
+			&& hotkeyPressed(g_pushToTalkVirtualKey.load(), g_pushToTalkModifiers.load());
+		if (pushToTalkDown != pushToTalkWasDown) {
+			if (const auto function = setPushToTalkFunction()) {
+				function(pushToTalkDown ? 1 : 0);
+			}
+			pushToTalkWasDown = pushToTalkDown;
+		}
+		Sleep(8);
+	}
+	if (pushToTalkWasDown) {
+		if (const auto function = setPushToTalkFunction()) {
+			function(0);
+		}
+	}
+}
 #endif
 
