+SetPushToTalkFn setPushToTalkFunction() {
+	static SetPushToTalkFn function = []() {
+		const HMODULE executable = GetModuleHandleW(nullptr);
+		return executable
+				   ? reinterpret_cast< SetPushToTalkFn >(GetProcAddress(executable, "EchoDeck_SetPushToTalk"))
+				   : nullptr;
