+extern "C" __declspec(dllexport) int EchoDeck_ConfigureHotkeys(int pushToTalkEnabled) {
+	QCoreApplication *application = QCoreApplication::instance();
+	if (!application) {
+		return -40;
+	}
+	const auto configure = [pushToTalkEnabled]() {
+		Global::get().iPushToTalk = 0;
+		Global::get().s.atTransmit =
+			pushToTalkEnabled != 0 ? Settings::PushToTalk : Settings::VAD;
+		if (Global::get().ai) {
+			Global::get().ai->bResetProcessor = true;
+		}
+		Global::get().s.save();
+	};
+	if (QThread::currentThread() == application->thread()) {
+		configure();
+		return 1;
+	}
+	const bool invoked = QMetaObject::invokeMethod(application, configure, Qt::BlockingQueuedConnection);
+	return invoked ? 1 : -41;
+}
+
+extern "C" __declspec(dllexport) int EchoDeck_SetPushToTalk(int down) {
+	QCoreApplication *application = QCoreApplication::instance();
+	if (!application || !Global::get().mw) {
+		return -40;
+	}
+	const auto update = [down]() {
+		if (Global::get().mw) {
+			Global::get().mw->on_PushToTalk_triggered(down != 0, QVariant());
+		}
+	};
+	if (QThread::currentThread() == application->thread()) {
+		update();
+		return 1;
+	}
+	const bool invoked = QMetaObject::invokeMethod(application, update, Qt::QueuedConnection);
+	return invoked ? 1 : -41;
+}
