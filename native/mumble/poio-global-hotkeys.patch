+ConfigureHotkeysFn configureHotkeysFunction() {
+	static ConfigureHotkeysFn function = []() {
+		const HMODULE executable = GetModuleHandleW(nullptr);
+		return executable
+				   ? reinterpret_cast< ConfigureHotkeysFn >(GetProcAddress(executable, "EchoDeck_ConfigureHotkeys"))
