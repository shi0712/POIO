+	const auto configure = []() {
+		// Voice activation prevents speaker leakage and room noise from being
+		// transmitted continuously. Multichannel Speex AEC receives WASAPI's
+		// speaker readback and removes the remote voices before VAD runs.
+		Global::get().s.atTransmit       = Settings::VAD;
+		Global::get().s.vsVAD            = Settings::SignalToNoise;
+		Global::get().s.fVADmin          = 0.35f;
+		Global::get().s.fVADmax          = 0.55f;
+		Global::get().s.iVoiceHold       = 30;
+		Global::get().s.echoOption       = EchoCancelOptionID::SPEEX_MULTICHANNEL;
+		Global::get().s.noiseCancelMode  = Settings::NoiseCancelBoth;
+		Global::get().s.iSpeexNoiseCancelStrength = -35;
+		Global::get().s.audioCueEnabledPTT = false;
+		Global::get().s.audioCueEnabledVAD = false;
+		// POIO owns the mute UX. The stock Mumble mute cue can otherwise open a
+		// native confirmation dialog the first time speech is detected while
+		// muted, even though Mumble itself is running hidden.
+		Global::get().s.bTxMuteCue      = false;
+		Global::get().s.muteCueShown    = true;
+		Global::get().s.bShowTalkingUI = false;
+		for (auto iterator = Global::get().s.qmMessages.begin(); iterator != Global::get().s.qmMessages.end(); ++iterator) {
+			iterator.value() = Settings::LogNone;
+		}
+		if (Global::get().ai) {
+			Global::get().ai->bResetProcessor = true;
+		}
+		Global::get().s.save();
+	};
+	if (QThread::currentThread() == application->thread()) {
+		configure();
+		return 1;
+	}
+	const bool invoked = QMetaObject::invokeMethod(application, configure, Qt::BlockingQueuedConnection);
+	return invoked ? 1 : -41;
