+// EchoDeck control bridge for the native Mumble client.
+// Uses Mumble's plugin API and a local Windows named pipe. No network listener is created.
+#include "../MumblePlugin.h"
+
+#include <atomic>
+#include <cstring>
+#include <string>
+#include <thread>
+
+#ifdef OS_WINDOWS
+#	include <windows.h>
+#endif
+
+namespace {
+MumbleAPI g_api{};
+mumble_plugin_id_t g_pluginID{};
+std::atomic_bool g_running{ false };
+std::thread g_pipeThread;
+
+#ifdef OS_WINDOWS
+std::wstring pipeName() {
+	wchar_t suffix[64]{};
+	const DWORD length = GetEnvironmentVariableW(L"POIO_MUMBLE_PIPE_SUFFIX", suffix, 64);
+	std::wstring name  = LR"(\\.\pipe\EchoDeckMumble)";
+	if (length > 0 && length < 64) {
+		bool valid = true;
+		for (DWORD index = 0; index < length; ++index) {
+			const wchar_t character = suffix[index];
+			if (!((character >= L'a' && character <= L'z') || (character >= L'A' && character <= L'Z')
+				  || (character >= L'0' && character <= L'9') || character == L'-' || character == L'_')) {
+				valid = false;
+				break;
+			}
+		}
+		if (valid) {
+			name += L'-';
+			name.append(suffix, length);
+		}
+	}
+	return name;
+}
+
+using GetAudioDevicesFn = const char *(*)();
+using SetAudioDeviceFn  = int (*)(int, int);
+using GetInputLevelFn   = int (*)();
+using GetVolumeFn       = int (*)(int);
+using SetVolumeFn       = int (*)(int, int);
+using GetUsersFn        = const char *(*)();
+using SetUserVolumeFn   = int (*)(const char *, int);
+using ConfigureRuntimeFn = int (*)();
+
+GetAudioDevicesFn getAudioDevicesFunction() {
+	static GetAudioDevicesFn function = []() {
+		const HMODULE executable = GetModuleHandleW(nullptr);
+		return executable ? reinterpret_cast< GetAudioDevicesFn >(GetProcAddress(executable, "EchoDeck_GetAudioDevices"))
+						  : nullptr;
+	}();
+	return function;
+}
+
+SetAudioDeviceFn setAudioDeviceFunction() {
+	static SetAudioDeviceFn function = []() {
+		const HMODULE executable = GetModuleHandleW(nullptr);
+		return executable ? reinterpret_cast< SetAudioDeviceFn >(GetProcAddress(executable, "EchoDeck_SetAudioDevice"))
+						  : nullptr;
+	}();
+	return function;
+}
+
+GetInputLevelFn getInputLevelFunction() {
+	static GetInputLevelFn function = []() {
+		const HMODULE executable = GetModuleHandleW(nullptr);
+		return executable ? reinterpret_cast< GetInputLevelFn >(GetProcAddress(executable, "EchoDeck_GetInputLevel"))
+						  : nullptr;
+	}();
+	return function;
+}
+
+GetVolumeFn getVolumeFunction() {
+	static GetVolumeFn function = []() {
+		const HMODULE executable = GetModuleHandleW(nullptr);
+		return executable ? reinterpret_cast< GetVolumeFn >(GetProcAddress(executable, "EchoDeck_GetVolume")) : nullptr;
+	}();
+	return function;
+}
+
+SetVolumeFn setVolumeFunction() {
+	static SetVolumeFn function = []() {
+		const HMODULE executable = GetModuleHandleW(nullptr);
+		return executable ? reinterpret_cast< SetVolumeFn >(GetProcAddress(executable, "EchoDeck_SetVolume")) : nullptr;
+	}();
+	return function;
+}
+
+GetUsersFn getUsersFunction() {
+	static GetUsersFn function = []() {
+		const HMODULE executable = GetModuleHandleW(nullptr);
+		return executable ? reinterpret_cast< GetUsersFn >(GetProcAddress(executable, "EchoDeck_GetUsers")) : nullptr;
+	}();
+	return function;
+}
+
+SetUserVolumeFn setUserVolumeFunction() {
+	static SetUserVolumeFn function = []() {
+		const HMODULE executable = GetModuleHandleW(nullptr);
+		return executable
+				   ? reinterpret_cast< SetUserVolumeFn >(GetProcAddress(executable, "EchoDeck_SetUserVolume"))
+				   : nullptr;
+	}();
+	return function;
+}
+
+ConfigureRuntimeFn configureRuntimeFunction() {
+	static ConfigureRuntimeFn function = []() {
+		const HMODULE executable = GetModuleHandleW(nullptr);
+		return executable
+				   ? reinterpret_cast< ConfigureRuntimeFn >(GetProcAddress(executable, "EchoDeck_ConfigureRuntime"))
+				   : nullptr;
+	}();
+	return function;
+}
+#endif
+
+MumbleStringWrapper staticString(const char *value) {
+	return { value, std::strlen(value), false };
+}
+
+std::string statusName(mumble_error_t status) {
+	return status == MUMBLE_STATUS_OK ? "OK" : "ERROR " + std::to_string(static_cast< int >(status));
+}
+
+std::string executeCommand(const std::string &line) {
+	if (line == "PING") {
+		return "OK PONG";
+	}
+	if (line == "STATUS") {
+		bool muted = false;
+		bool deafened = false;
+		mumble_connection_t connection{};
+		const auto connectionStatus = g_api.getActiveServerConnection(g_pluginID, &connection);
+		const auto muteStatus = g_api.isLocalUserMuted(g_pluginID, &muted);
+		const auto deafStatus = g_api.isLocalUserDeafened(g_pluginID, &deafened);
+		return "OK connected=" + std::to_string(connectionStatus == MUMBLE_STATUS_OK)
+			   + " muted=" + std::to_string(muteStatus == MUMBLE_STATUS_OK && muted)
+			   + " deafened=" + std::to_string(deafStatus == MUMBLE_STATUS_OK && deafened);
+	}
+	if (line.rfind("MUTE ", 0) == 0) {
+		return statusName(g_api.requestLocalUserMute(g_pluginID, line.substr(5) == "1"));
+	}
+	if (line.rfind("DEAF ", 0) == 0) {
+		return statusName(g_api.requestLocalUserDeaf(g_pluginID, line.substr(5) == "1"));
+	}
+#ifdef OS_WINDOWS
+	if (line == "CONFIGURE") {
+		const auto function = configureRuntimeFunction();
+		if (!function) {
+			return "ERROR native-configure-api-unavailable";
+		}
+		const int result = function();
+		return result == 1 ? "OK" : "ERROR configure-" + std::to_string(result);
+	}
+	if (line == "LEVEL") {
+		const auto function = getInputLevelFunction();
+		return function ? "OK " + std::to_string(function()) : "ERROR native-level-api-unavailable";
+	}
+	if (line == "VOLUMES") {
+		const auto function = getVolumeFunction();
+		return function ? "OK input=" + std::to_string(function(0)) + " output=" + std::to_string(function(1))
+						: "ERROR native-volume-api-unavailable";
+	}
+	if (line.rfind("SET_VOLUME ", 0) == 0) {
+		const auto function = setVolumeFunction();
+		if (!function) {
+			return "ERROR native-volume-api-unavailable";
+		}
+		try {
+			const auto separator = line.find(' ', 11);
+			const std::string kind = line.substr(11, separator - 11);
+			const int value        = std::stoi(line.substr(separator + 1));
+			const int result       = function(kind == "input" ? 0 : kind == "output" ? 1 : -1, value);
+			return result == 1 ? "OK" : "ERROR invalid-volume-" + std::to_string(result);
+		} catch (...) {
+			return "ERROR invalid-volume";
+		}
+	}
+	if (line == "USERS") {
+		const auto function = getUsersFunction();
+		if (!function) {
+			return "ERROR native-users-api-unavailable";
+		}
+		const char *json = function();
+		return json ? "OK " + std::string(json) : "ERROR user-enumeration-failed";
+	}
+	if (line.rfind("SET_USER_VOLUME ", 0) == 0) {
+		const auto function = setUserVolumeFunction();
+		if (!function) {
+			return "ERROR native-users-api-unavailable";
+		}
+		try {
+			const auto separator = line.find(' ', 16);
+			if (separator == std::string::npos) {
+				return "ERROR invalid-user-volume";
+			}
+			const std::string username = line.substr(16, separator - 16);
+			const int value            = std::stoi(line.substr(separator + 1));
+			const int result           = function(username.c_str(), value);
+			return result == 1 ? "OK" : "ERROR user-volume-" + std::to_string(result);
+		} catch (...) {
+			return "ERROR invalid-user-volume";
+		}
+	}
+	if (line == "DEVICES") {
+		const auto function = getAudioDevicesFunction();
+		if (!function) {
+			return "ERROR native-audio-api-unavailable";
+		}
+		const char *json = function();
+		return json ? "OK " + std::string(json) : "ERROR device-enumeration-failed";
+	}
+	if (line.rfind("SET_INPUT ", 0) == 0 || line.rfind("SET_OUTPUT ", 0) == 0) {
+		const bool input = line.rfind("SET_INPUT ", 0) == 0;
+		const auto function = setAudioDeviceFunction();
+		if (!function) {
+			return "ERROR native-audio-api-unavailable";
+		}
+		try {
+			const int index = std::stoi(line.substr(input ? 10 : 11));
+			const int result = function(input ? 0 : 1, index);
+			return result == 1 ? "OK" : "ERROR invalid-device-" + std::to_string(result);
+		} catch (...) {
+			return "ERROR invalid-device";
+		}
+	}
+#endif
+	if (line.rfind("MOVE ", 0) == 0) {
+		const auto channelName = line.substr(5);
+		if (channelName.empty()) {
+			return "ERROR empty-channel";
+		}
+		mumble_connection_t connection{};
+		mumble_userid_t user{};
+		mumble_channelid_t channel{};
+		if (g_api.getActiveServerConnection(g_pluginID, &connection) != MUMBLE_STATUS_OK
+			|| g_api.getLocalUserID(g_pluginID, connection, &user) != MUMBLE_STATUS_OK
+			|| g_api.findChannelByName(g_pluginID, connection, channelName.c_str(), &channel) != MUMBLE_STATUS_OK) {
+			return "ERROR channel-not-found";
+		}
+		return statusName(g_api.requestUserMove(g_pluginID, connection, user, channel, nullptr));
+	}
+	return "ERROR unknown-command";
+}
+
+#ifdef OS_WINDOWS
+void runPipe() {
+	const std::wstring controlPipe = pipeName();
+	while (g_running.load()) {
+		HANDLE pipe = CreateNamedPipeW(controlPipe.c_str(), PIPE_ACCESS_DUPLEX,
+			PIPE_TYPE_MESSAGE | PIPE_READMODE_MESSAGE | PIPE_WAIT | PIPE_REJECT_REMOTE_CLIENTS,
+			1, 4096, 4096, 250, nullptr);
+		if (pipe == INVALID_HANDLE_VALUE) {
+			Sleep(500);
+			continue;
+		}
+		const BOOL connected = ConnectNamedPipe(pipe, nullptr) || GetLastError() == ERROR_PIPE_CONNECTED;
+		if (connected && g_running.load()) {
+			char buffer[65536]{};
+			DWORD bytesRead = 0;
+			if (ReadFile(pipe, buffer, sizeof(buffer) - 1, &bytesRead, nullptr) && bytesRead > 0) {
+				std::string command(buffer, bytesRead);
+				while (!command.empty() && (command.back() == '\r' || command.back() == '\n' || command.back() == '\0')) {
+					command.pop_back();
+				}
+				const std::string response = executeCommand(command) + "\n";
+				DWORD bytesWritten = 0;
+				WriteFile(pipe, response.data(), static_cast< DWORD >(response.size()), &bytesWritten, nullptr);
+				FlushFileBuffers(pipe);
+			}
+		}
+		DisconnectNamedPipe(pipe);
+		CloseHandle(pipe);
+	}
+}
+
+void wakePipe() {
+	const std::wstring controlPipe = pipeName();
+	HANDLE pipe = CreateFileW(controlPipe.c_str(), GENERIC_WRITE, 0, nullptr, OPEN_EXISTING, 0, nullptr);
+	if (pipe != INVALID_HANDLE_VALUE) {
+		CloseHandle(pipe);
+	}
+}
+#endif
+} // namespace
+
+extern "C" MUMBLE_PLUGIN_EXPORT mumble_error_t mumble_init(mumble_plugin_id_t pluginID) {
+	g_pluginID = pluginID;
+	g_running.store(true);
+#ifdef OS_WINDOWS
+	g_pipeThread = std::thread(runPipe);
+#endif
+	g_api.log(g_pluginID, "EchoDeck native control bridge initialized");
+	return MUMBLE_STATUS_OK;
+}
+
+extern "C" MUMBLE_PLUGIN_EXPORT void mumble_shutdown() {
+	g_running.store(false);
+#ifdef OS_WINDOWS
+	wakePipe();
+	if (g_pipeThread.joinable()) {
+		g_pipeThread.join();
+	}
+#endif
+}
+
