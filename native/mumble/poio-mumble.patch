+extern "C" MUMBLE_PLUGIN_EXPORT mumble_version_t mumble_getAPIVersion() { return MUMBLE_PLUGIN_API_VERSION; }
+extern "C" MUMBLE_PLUGIN_EXPORT void mumble_registerAPIFunctions(void *api) { g_api = MUMBLE_API_CAST(api); }
+extern "C" MUMBLE_PLUGIN_EXPORT void mumble_releaseResource(const void *) {}
+extern "C" MUMBLE_PLUGIN_EXPORT mumble_version_t mumble_getVersion() { return { 0, 1, 0 }; }
+extern "C" MUMBLE_PLUGIN_EXPORT MumbleStringWrapper mumble_getAuthor() { return staticString("EchoDeck"); }
+extern "C" MUMBLE_PLUGIN_EXPORT MumbleStringWrapper mumble_getDescription() {
+	return staticString("Local IPC control for EchoDeck's Electron UI and Mumble native audio core.");
+}
+extern "C" MUMBLE_PLUGIN_EXPORT uint32_t mumble_getFeatures() { return MUMBLE_FEATURE_NONE; }
+extern "C" MUMBLE_PLUGIN_EXPORT uint32_t mumble_deactivateFeatures(uint32_t features) { return features; }
