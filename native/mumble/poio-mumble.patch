+extern "C" __declspec(dllexport) int EchoDeck_SetVolume(int kind, int value) {
+	QCoreApplication *application = QCoreApplication::instance();
+	if (!application) {
+		return -40;
+	}
+	const auto update = [kind, value]() {
+		if (kind == 0 && value >= 0 && value <= 100) {
+			Global::get().s.iMinLoudness = 20000 - static_cast< int >((value / 100.0f) * 19500.0f);
+			if (Global::get().ai) {
+				Global::get().ai->bResetProcessor = true;
+			}
+		} else if (kind == 1 && value >= 0 && value <= 200) {
+			Global::get().s.fVolume = value / 100.0f;
+		} else {
+			return false;
+		}
+		Global::get().s.save();
+		return true;
+	};
+	if (QThread::currentThread() == application->thread()) {
+		return update() ? 1 : -1;
+	}
+	bool changed = false;
+	const bool invoked = QMetaObject::invokeMethod(application, [&changed, update]() { changed = update(); },
+											 Qt::BlockingQueuedConnection);
+	return invoked && changed ? 1 : -41;
+}
