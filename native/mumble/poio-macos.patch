+void runPipe() {
+	const std::string controlPipe = pipeName();
+	::unlink(controlPipe.c_str());
+	const int listener = ::socket(AF_UNIX, SOCK_STREAM, 0);
+	if (listener < 0) {
+		return;
+	}
+	sockaddr_un address{};
+	address.sun_family = AF_UNIX;
+	std::strncpy(address.sun_path, controlPipe.c_str(), sizeof(address.sun_path) - 1);
+	if (::bind(listener, reinterpret_cast< sockaddr * >(&address), sizeof(address)) != 0
+		|| ::chmod(controlPipe.c_str(), S_IRUSR | S_IWUSR) != 0 || ::listen(listener, 4) != 0) {
+		::close(listener);
+		::unlink(controlPipe.c_str());
+		return;
+	}
+	while (g_running.load()) {
+		const int client = ::accept(listener, nullptr, nullptr);
+		if (client < 0) {
+			continue;
+		}
+		int noSigPipe = 1;
+		::setsockopt(client, SOL_SOCKET, SO_NOSIGPIPE, &noSigPipe, sizeof(noSigPipe));
+		char buffer[65536]{};
+		const ssize_t bytesRead = ::recv(client, buffer, sizeof(buffer) - 1, 0);
+		if (bytesRead > 0 && g_running.load()) {
+			std::string command(buffer, static_cast< std::size_t >(bytesRead));
+			while (!command.empty()
+				   && (command.back() == '\r' || command.back() == '\n' || command.back() == '\0')) {
+				command.pop_back();
+			}
+			const std::string response = executeCommand(command) + "\n";
+			::send(client, response.data(), response.size(), 0);
+		}
+		::close(client);
+	}
+	::close(listener);
+	::unlink(controlPipe.c_str());
+}
+
+void wakePipe() {
+	const std::string controlPipe = pipeName();
+	const int client = ::socket(AF_UNIX, SOCK_STREAM, 0);
+	if (client < 0) {
+		return;
+	}
+	sockaddr_un address{};
+	address.sun_family = AF_UNIX;
+	std::strncpy(address.sun_path, controlPipe.c_str(), sizeof(address.sun_path) - 1);
+	::connect(client, reinterpret_cast< sockaddr * >(&address), sizeof(address));
+	::close(client);
+}
 #endif
