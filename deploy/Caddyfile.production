{
  default_sni {$NIZ_PUBLIC_IP}
}

http://{$NIZ_PUBLIC_IP} {
  handle /.well-known/acme-challenge/* {
    root * /var/www/acme
    file_server
  }
  handle {
    redir https://{$NIZ_PUBLIC_IP}{uri} permanent
  }
}

https://{$NIZ_PUBLIC_IP} {
  tls /etc/letsencrypt/live/{$NIZ_PUBLIC_IP}/fullchain.pem /etc/letsencrypt/live/{$NIZ_PUBLIC_IP}/privkey.pem
  encode zstd gzip
  handle /download {
    redir /download/ permanent
  }
  handle_path /download/* {
    root * /srv/niz-download
    try_files {path} /index.html
    file_server
  }
  handle_path /releases/* {
    root * /srv/niz-releases
    file_server
  }
  handle /dmx {
    redir * /dmx/ permanent
  }
  handle_path /dmx/* {
    reverse_proxy 127.0.0.1:18180
  }

  # POIO is the public product path used by all new clients.
  handle /poio {
    redir * /poio/download/ permanent
  }
  handle /poio/ {
    redir * /poio/download/ permanent
  }
  # Existing Windows clients still check this legacy endpoint. Keep the URL
  # working, but move every release byte to the ModelScope CDN.
  handle_path /poio/releases/* {
    redir https://www.modelscope.cn/models/sjw712/POIO/resolve/master{uri} temporary
  }
  handle_path /poio/* {
    reverse_proxy 127.0.0.1:17920
  }

  # Temporary compatibility for already-installed legacy clients. This route
  # is intentionally not linked or displayed on the public website.
  handle /echodeck {
    redir * /poio/download/ permanent
  }
  handle /echodeck/ {
    redir * /poio/download/ permanent
  }
  handle_path /echodeck/* {
    reverse_proxy 127.0.0.1:17920
  }
  handle {
    reverse_proxy 127.0.0.1:17890
  }
}

# Browser client and its API/WebSocket share one origin. Keeping /poio for the
# backend preserves compatibility with every existing POIO server route.
poio.sjwnb.online {
  encode zstd gzip
  handle /poio {
    uri strip_prefix /poio
    reverse_proxy 127.0.0.1:17920
  }
  handle /poio/* {
    uri strip_prefix /poio
    reverse_proxy 127.0.0.1:17920
  }
  handle {
    root * /srv/niz-download/poio-web/current
    try_files {path} /index.html
    file_server
  }
}
