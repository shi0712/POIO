{
  "name": "@echodeck/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-generated.mjs",
    "start": "node dist/index.js",
    "test": "tsx --test src/**/*.test.ts",
    "test:p2p": "npm run build && node scripts/p2p-local-smoke.mjs"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "ice": "^3.7.110",
    "mediasoup": "^3.21.2",
    "multer": "^2.0.2",
    "nanoid": "^5.1.6",
    "socket.io": "^4.8.3",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.0",
    "slice2js": "^3.7.110",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
