HOST=127.0.0.1
PORT=17920
PUBLIC_IP=203.0.113.10
MUMBLE_PUBLIC_HOST=203.0.113.10
MUMBLE_PORT=64738
MUMBLE_SERVER_PASSWORD=replace-with-a-long-random-password
MUMBLE_ICE_ENDPOINT=tcp -h 127.0.0.1 -p 6502
MUMBLE_ICE_SECRET=replace-with-a-different-long-random-secret
DATABASE_PATH=./data/echodeck.db
BACKUP_PATH=./data/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
UPLOAD_PATH=./data/uploads
DOWNLOAD_PATH=./deploy/download
RELEASE_PATH=./releases
MEDIASOUP_PORT=17921
MEDIASOUP_MIN_PORT=42000
MEDIASOUP_MAX_PORT=42100
# Comma separated STUN endpoints used only to discover direct P2P routes.
P2P_STUN_URLS=stun:203.0.113.10:3478,stun:stun.cloudflare.com:3478
# TURN is optional because POIO falls back to mediasoup when direct P2P fails.
# P2P_TURN_URLS=turn:203.0.113.10:3478?transport=udp
# P2P_TURN_USERNAME=poio
# P2P_TURN_PASSWORD=replace-with-a-long-random-password
SESSION_DAYS=30
CORS_ORIGIN=*
