{
  "name": "@echodeck/desktop",
  "version": "0.8.4",
  "description": "低延迟语音、频道聊天与高清屏幕共享客户端",
  "author": "POIO",
  "private": true,
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"npm run dev:electron\"",
    "dev:electron": "tsc -p tsconfig.electron.json --watch --preserveWatchOutput & wait-on tcp:5173 file:dist-electron/main.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "test": "tsc --noEmit -p tsconfig.json",
    "native:share": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../../native/share-core/scripts/stage-desktop.ps1",
    "dist:win": "npm run native:share && npm run build && electron-builder --win nsis",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --arm64 --config electron-builder.mac.yml"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "lucide-react": "^0.468.0",
    "mediasoup-client": "^3.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.0.3",
    "cross-env": "^10.1.0",
    "electron": "43.1.1",
    "electron-builder": "^26.15.3",
    "vite": "^8.1.5",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.poio.desktop",
    "productName": "POIO",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/mumble",
        "to": "mumble"
      },
      {
        "from": "resources/share",
        "to": "share"
      }
    ],
    "asar": true,
    "releaseInfo": {
      "releaseNotesFile": "build/release-notes.md"
    },
    "protocols": [
      {
        "name": "POIO 社区邀请",
        "schemes": [
          "poio"
        ]
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://www.modelscope.cn/models/sjw712/POIO/resolve/master/"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "POIO-${version}-x64-Setup.${ext}",
      "language": "2052"
    }
  }
}
